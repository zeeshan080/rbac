# Main Database Connection (use asyncpg driver for async)
DATABASE_URL="postgresql+asyncpg://user:password@host:port/dbname" # Ensure this matches the required format

# JWT Secret Key (generate a strong random key)
# Example: openssl rand -hex 32
SECRET_KEY="your_super_secret_random_jwt_token_string_here"

# Base URL for API version 1 (defined in app/core/config.py, but can be overridden here if Settings model is updated)
# API_V1_STR="/api/v1"

# Optional: Test Database Connection
# DATABASE_URL_TEST="postgresql+asyncpg://test_user:test_password@test_host:test_port/test_dbname" # Ensure this matches the required format

# Optional: For email sending features (not yet implemented)
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_TLS=True
# EMAILS_FROM_EMAIL="noreply@example.com"

# Logging Level (e.g., DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Email Verification Token Expiry (in hours)
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Password Reset Token Expiry (in hours)
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# Account Lockout Policy
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
